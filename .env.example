# Set APP_ENV as a real environment variable. The value in .env is ignored for safety.
APP_ENV=local
DRY_RUN=true
# true: real contact lookups (Apollo, Hunter, Snov, Prospeo, Tomba) on your PC only
# (APP_ENV local); DRY_RUN stays on, so nothing else becomes real. Uses free credits.
CONTACTS_LIVE=false
NOTION_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
# Optional: only used when a Config model.<stage> row names a gemini-... model, and only in
# prod (local and dev always use haiku). See docs/ai-models.md.
GEMINI_API_KEY=
# Optional: for Config model.<stage> = deepseek-... (plan C, 25 Oct: every stage except the
# web searches). See docs/ai-models.md.
DEEPSEEK_API_KEY=
# Job-alert mailboxes (both get the "Job Alerts" label). The old GMAIL_ALERTS_TOKEN_JSON
# still works and is read as m02.
GMAIL_ALERTS_TOKEN_JSON_m02=
GMAIL_ALERTS_TOKEN_JSON_mm=
# local/dev: token of madeshwaranm02@gmail.com only. Never put the main account token here outside prod.
GMAIL_SENDER_TOKEN_JSON=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Free key from https://jooble.org/api/about (optional; adds Ireland job boards)
JOOBLE_API_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
# Free plans with API access (contact search after Apollo, Hunter, Snov): prospeo.io, tomba.io
PROSPEO_API_KEY=
# Second accounts: used when the first account's credits run out (Config credits.<name>_2).
APOLLO_API_KEY_2=
HUNTER_API_KEY_2=
SNOV_CLIENT_ID_2=
SNOV_CLIENT_SECRET_2=
PROSPEO_API_KEY_2=
TOMBA_API_KEY=
TOMBA_API_SECRET=
TOMBA_API_KEY_2=
TOMBA_API_SECRET_2=
# Optional: engineers from public GitHub organisations (Config contacts.github "on").
# A fine-grained token with no permissions is enough (public data, higher rate limit).
GITHUB_TOKEN=
# Optional, prod only: Lusha probe (python -m jobengine.contacts --probe lusha).
LUSHA_API_KEY=
# Cloud Run only (Module 09). Local runs use long polling.
BOT_MODE=polling
# 32+ letters and digits; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# The Cloud Run service URL (audience of the Cloud Scheduler OIDC token).
SERVICE_URL=
# The service account Cloud Scheduler signs its requests with.
SCHEDULER_SA_EMAIL=
# Optional (Autopilot H4): your healthchecks.io check's ping URL (https://hc-ping.com/...).
# The bot pings it after each daily report; no ping for 26 hours and healthchecks.io emails
# you. Treat it like a password. docs/tracking.md "Heartbeat".
HEALTHCHECK_URL=
