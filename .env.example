# Set APP_ENV as a real environment variable. The value in .env is ignored for safety.
APP_ENV=local
DRY_RUN=true
NOTION_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
GMAIL_ALERTS_TOKEN_JSON=
# local/dev: token of madeshwaranm02@gmail.com only. Never put the main account token here outside prod.
GMAIL_SENDER_TOKEN_JSON=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
APOLLO_API_KEY=
HUNTER_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
# Cloud Run only (Module 09). Local runs use long polling.
BOT_MODE=polling
# 32+ letters and digits; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# The Cloud Run service URL (audience of the Cloud Scheduler OIDC token).
SERVICE_URL=
# The service account Cloud Scheduler signs its requests with.
SCHEDULER_SA_EMAIL=
